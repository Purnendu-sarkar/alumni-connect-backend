# ==============================================================================
# AlumniConnect Backend - Environment Configuration Template (.env.example)
# Single-University, Privacy-First Academic Networking Platform
# Copy this file to .env and adjust variables as required. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Application URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. Database Connection (Prisma / PostgreSQL)
# Option A: Neon Serverless PostgreSQL (Recommended):
#   DATABASE_URL="postgresql://<user>:<password>@<neon-host>-pooler.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://<user>:<password>@<neon-host>.tech/neondb?sslmode=require"
# Option B: Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public"
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# ------------------------------------------------------------------------------
# 4. Redis Cache & Rate Limiting
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# 5. Authentication & Cookie Sessions (JWT)
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_64_character_minimum_random_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_a_64_character_minimum_random_secret_for_refresh_token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_SECRET=replace_with_a_64_character_minimum_session_cookie_secret
COOKIE_SECURE=false
ADMIN_REAUTH_WINDOW_MINUTES=15

# ------------------------------------------------------------------------------
# 6. Automatic First Super Admin Initialization (Zero Manual Seed)
# On backend start, if no Super Admin exists, the system automatically provisions
# this account with a single-use setup token and sends an onboarding email.
# ------------------------------------------------------------------------------
INITIAL_SUPER_ADMIN_EMAIL=admin@your-university.ac.bd
BOOTSTRAP_SUPER_ADMIN_NAME="Platform Super Admin"
INITIAL_SUPER_ADMIN_SETUP_TOKEN_EXPIRY=48h

# Institutional details
INSTITUTION_NAME="North Western University"
INSTITUTION_DOMAIN="nwu.ac.bd"

# ------------------------------------------------------------------------------
# 7. Centralized Email Configuration (Google Gmail SMTP & Local Fallback)
# ------------------------------------------------------------------------------
# OPTION A: Google Gmail SMTP (Recommended for Live Academic Demo)
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
#    - Select app: "Mail", device: "Other (AlumniConnect)"
# 3. Enter your Gmail in SMTP_USER and the 16-character code in SMTP_PASS
#
# OPTION B: Local Mailpit (For offline local zero-budget development)
#   Run Mailpit locally on localhost:1025 | Web UI: http://localhost:8025
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="AlumniConnect <noreply@your-university.ac.bd>"
EMAIL_ENABLED=true
EMAIL_CONNECTION_TIMEOUT=10000
EMAIL_GREETING_TIMEOUT=10000
EMAIL_SOCKET_TIMEOUT=20000
