# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# Use a pooled URL at runtime. For a hosted PostgreSQL provider, DIRECT_URL should
# point to its direct (non-pooler) endpoint so Prisma Migrate can create migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public

# Generate unique values with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-64-character-minimum-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-minimum-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional: used by `npm run db:seed` to create a first admin for local development.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=ChangeMe123!

