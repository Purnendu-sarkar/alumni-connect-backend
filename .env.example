# ==============================================================================
# AlumniConnect Backend - Academic Demonstration Environment Template (.env.example)
# Note: Copy this file to .env and adjust variables as required. Never commit real secrets.
# ==============================================================================

# Runtime Environment
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Connection (Prisma / PostgreSQL)
# Option A (Local PostgreSQL - Zero Budget):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public"
# Option B (Neon Free Tier Serverless PostgreSQL):
#   DATABASE_URL="postgresql://<user>:<password>@<neon-host>-pooler.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://<user>:<password>@<neon-host>.tech/neondb?sslmode=require"
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public

# ------------------------------------------------------------------------------
# Authentication Tokens (JWT)
# Minimum 32-character (recommended 64-char) base64url random secrets.
# Generate locally via: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_64_character_minimum_random_secret_for_access_token_demo
JWT_REFRESH_SECRET=replace_with_a_64_character_minimum_random_secret_for_refresh_token_demo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# Bootstrap Super Admin Credentials (Automated First-Run Initialization)
# If no Super Admin exists, the server bootstraps this account automatically on startup.
# ------------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=SuperAdminPass123!
BOOTSTRAP_SUPER_ADMIN_NAME="Platform Super Admin"
BOOTSTRAP_UNIVERSITY_NAME="AlumniConnect Network"
BOOTSTRAP_UNIVERSITY_SLUG="platform-primary"
BOOTSTRAP_UNIVERSITY_DOMAIN="alumniconnect.internal"

# ------------------------------------------------------------------------------
# Local Academic Demo Mode (Development Only - Must be false in production)
# Enables the /api/v1/dev/demo endpoints and quick one-click login buttons on UI.
# ------------------------------------------------------------------------------
DEMO_ENABLED=true

# ------------------------------------------------------------------------------
# Email Testing via Mailpit (Local SMTP Server - Zero Cost)
# Download / Run Mailpit:
#   Windows (scoop): scoop install mailpit && mailpit
#   Or download binary from https://github.com/axllent/mailpit/releases
#   Web UI: http://localhost:8025 | SMTP Port: localhost:1025
# If Mailpit is not running, emails are logged to console and buffered at:
#   GET http://localhost:5000/api/v1/dev/demo/emails
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AlumniConnect <noreply@alumniconnect.internal>"
APP_FRONTEND_URL=http://localhost:3000
