generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  STUDENT
  ALUMNI
  MODERATOR
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrivacyScope {
  PUBLIC
  ALL_MEMBERS
  CONNECTIONS_ONLY
  ONLY_ME
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  REJECTED
  CANCELLED
  BLOCKED
}

enum MentorshipStatus {
  REQUESTED
  CLARIFICATION_REQUESTED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
  PENDING
  ACCEPTED
  DECLINED
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum UploadPurpose {
  PROFILE_PHOTO
  RESUME
  STORY_MEDIA
  EVENT_BANNER
  ANNOUNCEMENT_ATTACHMENT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum NotificationType {
  ACCOUNT_VERIFICATION
  VERIFICATION_PENDING
  MODERATION_RESULT
  SECURITY_ALERT
  RESTRICTION_APPLIED
  RESTRICTION_ENDED
  SYSTEM_ANNOUNCEMENT
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MENTORSHIP_REQUEST
  MENTORSHIP_DECISION
  JOB_APPROVED
  JOB_REJECTED
  JOB_CHANGES_REQUESTED
  APPLICATION_RECEIVED
  APPLICATION_UPDATE
  EVENT_REMINDER
  ANNOUNCEMENT
  STORY_REVIEW
}

model University {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  domain           String             @unique
  branding         Json?
  subscriptionPlan String             @default("free")
  isActive         Boolean            @default(true)
  isDemo           Boolean            @default(false)
  users            User[]
  refreshTokens    RefreshToken[]
  connections      Connection[]
  mentorships      MentorshipRequest[]
  jobs             Job[]
  events           Event[]
  contents         Content[]
  reports          Report[]
  mediaAssets      MediaAsset[]
  adSlots          AdSlot[]
  analyticsEvents  AnalyticsEvent[]
  auditLogs        AuditLog[]
  departments      Department[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([isDemo])
}

model User {
  id                  String              @id @default(cuid())
  universityId        String
  roleId              String
  name                String
  email               String              @unique
  passwordHash        String
  batch               String?
  departmentId        String?
  departmentRef       Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  department          String?
  currentCompany      String?
  position            String?
  bio                 String?
  headline            String?
  studentId           String?
  currentSemester     String?
  admissionYear       String?
  expectedGraduationYear String?
  graduationYear      String?
  academicId          String?
  employmentStatus    String?
  location            String?
  phone               String?
  phonePublic         Boolean             @default(false)
  linkedinUrl         String?
  websiteUrl          String?
  githubUrl           String?
  skills              String[]            @default([])
  interests           String[]            @default([])
  avatarUrl           String?
  avatarPublicId      String?
  verified            Boolean             @default(false)
  verificationStatus  VerificationStatus  @default(PENDING)
  rejectionReason     String?
  verifiedAt          DateTime?
  onboardingCompleted Boolean             @default(false)
  isMentorshipAvailable Boolean           @default(false)
  mentorshipStatus    String              @default("CLOSED")
  maxActiveMentees    Int                 @default(5)
  mentorshipTopics    String[]            @default([])
  isActive            Boolean             @default(true)
  isDemo              Boolean             @default(false)
  needPasswordChange  Boolean             @default(false)
  university          University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  role                Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  privacySetting      PrivacySetting?
  blocksGiven         Block[]             @relation("BlocksGiven")
  blocksReceived      Block[]             @relation("BlocksReceived")
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  moderatorInvitationsSent ModeratorInvitation[] @relation("ModeratorInviter")
  sentConnections     Connection[]        @relation("ConnectionRequester")
  receivedConnections Connection[]        @relation("ConnectionRecipient")
  mentoringRequests   MentorshipRequest[] @relation("Mentor")
  menteeRequests      MentorshipRequest[] @relation("Mentee")
  jobsPosted          Job[]               @relation("JobPoster")
  jobsApproved        Job[]               @relation("JobApprover")
  jobApplications     JobApplication[]
  reportsFiled        Report[]            @relation("ReportReporter")
  eventsCreated       Event[]             @relation("EventCreator")
  contentsCreated     Content[]           @relation("ContentCreator")
  mediaUploaded       MediaAsset[]        @relation("MediaUploader")
  uploadedFiles       UploadedFile[]
  analyticsEvents     AnalyticsEvent[]
  auditLogs           AuditLog[]          @relation("AuditActor")
  notifications       Notification[]
  notificationPreferences NotificationPreference[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([universityId, roleId, verified])
  @@index([universityId, verificationStatus])
  @@index([universityId, roleId, verificationStatus])
  @@index([universityId, department, batch])
  @@index([universityId, departmentId])
  @@index([universityId, currentCompany])
  @@index([isDemo])
  @@index([universityId, isDemo])
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
}

model Department {
  id           String     @id @default(cuid())
  universityId String
  name         String
  code         String
  faculty      String?
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([universityId, name])
  @@unique([universityId, code])
  @@index([universityId, isActive, displayOrder])
}

model RefreshToken {
  id                  String     @id
  tokenHash           String     @unique
  familyId            String?
  replacedByTokenHash String?
  userId              String
  universityId        String
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([universityId])
  @@index([familyId])
}

model Connection {
  id          String           @id @default(cuid())
  universityId String
  requesterId String
  recipientId String
  userLowId   String?
  userHighId  String?
  status      ConnectionStatus @default(PENDING)
  message     String?
  respondedAt DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  university  University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([universityId, userLowId, userHighId])
  @@index([universityId, status, createdAt])
  @@index([recipientId, status])
  @@index([userLowId, userHighId])
}

model MentorshipRequest {
  id                     String           @id @default(cuid())
  universityId           String
  mentorId               String
  menteeId               String
  topic                  String           @default("General Mentorship")
  careerGoal             String           @default("Career Guidance")
  message                String           @default("")
  goals                  String           @default("")
  preferredCommunication String           @default("CHAT")
  availability           String           @default("Flexible")
  expectedDuration       String?
  status                 MentorshipStatus @default(REQUESTED)
  clarificationQuestion  String?
  clarificationReply     String?
  alumniNote             String?
  decisionNote           String?
  scheduledAt            DateTime?
  startedAt              DateTime?
  endedAt                DateTime?
  endedById              String?
  endNote                String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  university             University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  mentor                 User             @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee                 User             @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([universityId, status])
  @@index([mentorId, status])
  @@index([menteeId, status])
}

model PrivacySetting {
  id                    String       @id @default(cuid())
  userId                String       @unique
  profileVisibility     PrivacyScope @default(ALL_MEMBERS)
  emailVisibility       PrivacyScope @default(CONNECTIONS_ONLY)
  phoneVisibility       PrivacyScope @default(ONLY_ME)
  locationVisibility    PrivacyScope @default(ALL_MEMBERS)
  careerVisibility      PrivacyScope @default(ALL_MEMBERS)
  educationVisibility   PrivacyScope @default(ALL_MEMBERS)
  skillsVisibility      PrivacyScope @default(ALL_MEMBERS)
  connectionsVisibility PrivacyScope @default(ALL_MEMBERS)
  mentorshipVisibility  PrivacyScope @default(ALL_MEMBERS)
  searchVisibility      PrivacyScope @default(ALL_MEMBERS)
  messagingPermission   PrivacyScope @default(ALL_MEMBERS)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Job {
  id           String    @id @default(cuid())
  universityId String
  postedById   String
  approvedById String?
  title        String
  description  String
  company      String
  location     String?
  employmentType String?
  applicationUrl String?
  applicationEmail String?
  status       JobStatus @default(PENDING)
  expiresAt    DateTime?
  approvedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  postedBy     User      @relation("JobPoster", fields: [postedById], references: [id], onDelete: Restrict)
  approvedBy   User?     @relation("JobApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([universityId, status, createdAt])
  @@index([universityId, company])
}

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  applicantId String
  message   String?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([applicantId, createdAt])
}

model Event {
  id           String     @id @default(cuid())
  universityId String
  createdById  String
  title        String
  description  String
  slug         String
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  bannerPublicId String?
  isPublished  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  media        MediaAsset[]

  @@unique([universityId, slug])
  @@index([universityId, startsAt])
}

model Content {
  id           String        @id @default(cuid())
  universityId String
  createdById  String
  type         String
  title        String
  body         String
  slug         String
  mediaPublicId String?
  mediaType    MediaType?
  status       ContentStatus @default(DRAFT)
  metaTitle    String?
  metaDescription String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("ContentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([universityId, slug])
  @@index([universityId, status, publishedAt])
}

model Report {
  id           String       @id @default(cuid())
  universityId String
  reportedById String
  targetType   String
  targetId     String
  reason       String
  status       ReportStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  reportedBy   User         @relation("ReportReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  @@index([universityId, status, createdAt])
  @@index([targetType, targetId])
}

model MediaAsset {
  id           String     @id @default(cuid())
  universityId String
  uploadedById String
  eventId      String?
  url          String
  providerKey  String?
  type         MediaType
  bytes        Int?
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  event        Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([universityId, createdAt])
  @@index([eventId])
}

model AdSlot {
  id           String     @id @default(cuid())
  universityId String
  position     String
  sponsor      String
  content      Json
  isActive     Boolean    @default(true)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId, position, isActive])
}

model AnalyticsEvent {
  id           String     @id @default(cuid())
  universityId String
  userId       String?
  eventType    String
  metadata     Json?
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([universityId, eventType, createdAt])
}

model AuditLog {
  id           String       @id @default(cuid())
  universityId String
  actorId      String?
  actorRole    String?
  action       String
  targetType   String?
  targetId     String?
  result       AuditResult  @default(SUCCESS)
  ip           String?
  userAgent    String?
  requestId    String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([universityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([result, createdAt(sort: Desc)])
  @@index([requestId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  type       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
}

model ModeratorInvitation {
  id          String    @id @default(cuid())
  email       String    @unique
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("ModeratorInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([tokenHash])
}

model UploadedFile {
  id          String        @id @default(cuid())
  userId      String
  purpose     UploadPurpose
  mediaType   MediaType     @default(IMAGE)
  publicId    String        @unique
  url         String
  secureUrl   String
  format      String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Float?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("uploaded_files")
}


