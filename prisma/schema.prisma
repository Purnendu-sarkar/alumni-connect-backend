generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  STUDENT
  ALUMNI
  MODERATOR
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrivacyScope {
  PUBLIC
  ALL_MEMBERS
  CONNECTIONS_ONLY
  ONLY_ME
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  REJECTED
  CANCELLED
  BLOCKED
}

enum MentorshipStatus {
  REQUESTED
  CLARIFICATION_REQUESTED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
  PENDING
  ACCEPTED
  DECLINED
}

enum JobStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  CLOSED
  PENDING
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ANY
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR
  EXECUTIVE
}

enum JobModerationAction {
  SUBMIT
  WITHDRAW
  CLAIM
  UNCLAIM
  APPROVE
  REJECT
  REQUEST_CHANGES
  OVERRIDE
  CLOSE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  REVIEWED
  RESOLVED
  REJECTED
  DISMISSED
  ESCALATED
}

enum ReportType {
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  SPAM
  MISLEADING_JOB
  HARASSMENT
  OTHER
}

enum RestrictionType {
  MESSAGING
  JOB_POSTING
  MENTORSHIP_REQUESTS
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum UploadPurpose {
  PROFILE_PHOTO
  RESUME
  STORY_MEDIA
  EVENT_BANNER
  ANNOUNCEMENT_ATTACHMENT
  MESSAGE_ATTACHMENT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum NotificationType {
  ACCOUNT_VERIFICATION
  VERIFICATION_PENDING
  MODERATION_RESULT
  SECURITY_ALERT
  RESTRICTION_APPLIED
  RESTRICTION_ENDED
  SYSTEM_ANNOUNCEMENT
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MENTORSHIP_REQUEST
  MENTORSHIP_DECISION
  JOB_APPROVED
  JOB_REJECTED
  JOB_CHANGES_REQUESTED
  APPLICATION_RECEIVED
  APPLICATION_UPDATE
  EVENT_REMINDER
  ANNOUNCEMENT
  STORY_REVIEW
  NEW_MESSAGE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
  WAITLISTED
  CANCELLED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  CAREER
  EVENT
  SECURITY_SYSTEM
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  ALUMNI
}

model University {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  domain           String             @unique
  branding         Json?
  settings         Json?
  subscriptionPlan String             @default("free")
  isActive         Boolean            @default(true)
  isDemo           Boolean            @default(false)
  users            User[]
  refreshTokens    RefreshToken[]
  connections      Connection[]
  mentorships      MentorshipRequest[]
  jobs             Job[]
  events           Event[]
  announcements    Announcement[]
  contents         Content[]
  stories          SuccessStory[]
  reports          Report[]
  restrictions     UserRestriction[]
  mediaAssets      MediaAsset[]
  adSlots          AdSlot[]
  analyticsEvents  AnalyticsEvent[]
  auditLogs        AuditLog[]
  departments      Department[]
  conversations    Conversation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([isDemo])
}

model User {
  id                  String              @id @default(cuid())
  universityId        String
  roleId              String
  name                String
  email               String              @unique
  passwordHash        String
  batch               String?
  departmentId        String?
  departmentRef       Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  department          String?
  currentCompany      String?
  position            String?
  bio                 String?
  headline            String?
  studentId           String?
  currentSemester     String?
  admissionYear       String?
  expectedGraduationYear String?
  graduationYear      String?
  academicId          String?
  employmentStatus    String?
  location            String?
  phone               String?
  phonePublic         Boolean             @default(false)
  linkedinUrl         String?
  websiteUrl          String?
  githubUrl           String?
  skills              String[]            @default([])
  interests           String[]            @default([])
  avatarUrl           String?
  avatarPublicId      String?
  verified            Boolean             @default(false)
  verificationStatus  VerificationStatus  @default(PENDING)
  rejectionReason     String?
  verifiedAt          DateTime?
  onboardingCompleted Boolean             @default(false)
  isMentorshipAvailable Boolean           @default(false)
  mentorshipStatus    String              @default("CLOSED")
  maxActiveMentees    Int                 @default(5)
  mentorshipTopics    String[]            @default([])
  isActive            Boolean             @default(true)
  deactivatedAt       DateTime?           @db.Timestamptz(6)
  deletionRequestedAt DateTime?           @db.Timestamptz(6)
  deletedAt           DateTime?           @db.Timestamptz(6)
  isDemo              Boolean             @default(false)
  needPasswordChange  Boolean             @default(false)
  university          University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  role                Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  privacySetting      PrivacySetting?
  blocksGiven         Block[]             @relation("BlocksGiven")
  blocksReceived      Block[]             @relation("BlocksReceived")
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  moderatorInvitationsSent ModeratorInvitation[] @relation("ModeratorInviter")
  sentConnections     Connection[]        @relation("ConnectionRequester")
  receivedConnections Connection[]        @relation("ConnectionRecipient")
  mentoringRequests   MentorshipRequest[] @relation("Mentor")
  menteeRequests      MentorshipRequest[] @relation("Mentee")
  jobsPosted          Job[]                         @relation("JobPoster")
  jobsReviewed        Job[]                         @relation("JobReviewer")
  jobsApproved        Job[]                         @relation("JobApprover")
  jobApplications     JobApplication[]              @relation("ApplicationApplicant")
  jobModerations      JobModerationRecord[]         @relation("JobModActor")
  jobAppStatusChanges JobApplicationStatusHistory[] @relation("JobAppHistoryActor")
  reportsFiled        Report[]            @relation("ReportReporter")
  reportsReceived     Report[]            @relation("ReportedUser")
  reportsReviewed     Report[]            @relation("ReportReviewer")
  reportsResolved     Report[]            @relation("ReportResolver")
  reportActions       ReportAction[]      @relation("ReportActionActor")
  restrictionsReceived UserRestriction[]  @relation("RestrictionSubject")
  restrictionsCreated  UserRestriction[]  @relation("RestrictionCreator")
  eventsCreated       Event[]             @relation("EventCreator")
  eventRsvps          EventRsvp[]         @relation("RsvpUser")
  announcements       Announcement[]      @relation("AnnouncementAuthor")
  contentsCreated     Content[]           @relation("ContentCreator")
  authoredStories     SuccessStory[]      @relation("StoryAuthor")
  reviewedStories     SuccessStory[]      @relation("StoryReviewer")
  storyModerations    StoryModerationRecord[] @relation("StoryModerator")
  mediaUploaded       MediaAsset[]        @relation("MediaUploader")
  uploadedFiles       UploadedFile[]
  analyticsEvents     AnalyticsEvent[]
  auditLogs           AuditLog[]          @relation("AuditActor")
  notifications       Notification[]
  notificationPreferences NotificationPreference[]
  conversationsCreated Conversation[]      @relation("ConversationCreator")
  conversationParticipations ConversationParticipant[] @relation("ParticipantUser")
  messagesSent        Message[]           @relation("MessageSender")
  dataExports         DataExportRequest[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([universityId, roleId, verified])
  @@index([universityId, verificationStatus])
  @@index([universityId, roleId, verificationStatus])
  @@index([universityId, department, batch])
  @@index([universityId, departmentId])
  @@index([universityId, currentCompany])
  @@index([isDemo])
  @@index([universityId, isDemo])
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
}

model Department {
  id           String     @id @default(cuid())
  universityId String
  name         String
  code         String
  faculty      String?
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([universityId, name])
  @@unique([universityId, code])
  @@index([universityId, isActive, displayOrder])
}

model RefreshToken {
  id                  String     @id
  tokenHash           String     @unique
  familyId            String?
  replacedByTokenHash String?
  userId              String
  universityId        String
  userAgent           String?
  ipAddress           String?    @db.VarChar(64)
  deviceName          String?    @db.VarChar(120)
  lastActiveAt        DateTime   @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([universityId])
  @@index([familyId])
}

model DataExportRequest {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("COMPLETED")
  payload   Json?
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Connection {
  id          String           @id @default(cuid())
  universityId String
  requesterId String
  recipientId String
  userLowId   String?
  userHighId  String?
  status      ConnectionStatus @default(PENDING)
  message     String?
  respondedAt DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  university  University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([universityId, userLowId, userHighId])
  @@index([universityId, status, createdAt])
  @@index([recipientId, status])
  @@index([userLowId, userHighId])
}

model MentorshipRequest {
  id                     String           @id @default(cuid())
  universityId           String
  mentorId               String
  menteeId               String
  topic                  String           @default("General Mentorship")
  careerGoal             String           @default("Career Guidance")
  message                String           @default("")
  goals                  String           @default("")
  preferredCommunication String           @default("CHAT")
  availability           String           @default("Flexible")
  expectedDuration       String?
  status                 MentorshipStatus @default(REQUESTED)
  clarificationQuestion  String?
  clarificationReply     String?
  alumniNote             String?
  decisionNote           String?
  scheduledAt            DateTime?
  startedAt              DateTime?
  endedAt                DateTime?
  endedById              String?
  endNote                String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  university             University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  mentor                 User             @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee                 User             @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([universityId, status])
  @@index([mentorId, status])
  @@index([menteeId, status])
}

model PrivacySetting {
  id                    String       @id @default(cuid())
  userId                String       @unique
  profileVisibility     PrivacyScope @default(ALL_MEMBERS)
  emailVisibility       PrivacyScope @default(CONNECTIONS_ONLY)
  phoneVisibility       PrivacyScope @default(ONLY_ME)
  locationVisibility    PrivacyScope @default(ALL_MEMBERS)
  careerVisibility      PrivacyScope @default(ALL_MEMBERS)
  educationVisibility   PrivacyScope @default(ALL_MEMBERS)
  skillsVisibility      PrivacyScope @default(ALL_MEMBERS)
  connectionsVisibility PrivacyScope @default(ALL_MEMBERS)
  mentorshipVisibility  PrivacyScope @default(ALL_MEMBERS)
  searchVisibility      PrivacyScope @default(ALL_MEMBERS)
  messagingPermission   PrivacyScope @default(ALL_MEMBERS)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Job {
  id                 String                @id @default(cuid())
  universityId       String
  postedById         String
  reviewerId         String?
  approvedById       String?
  title              String
  description        String
  requirements       String?               @db.Text
  company            String
  category           String                @default("General")
  employmentType     String?               @default("FULL_TIME")
  workMode           WorkMode              @default(ON_SITE)
  experienceLevel    ExperienceLevel       @default(ANY)
  location           String?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String                @default("BDT")
  deadline           DateTime              @default(now())
  expiresAt          DateTime?
  referralAvailable  Boolean               @default(false)
  requireResume      Boolean               @default(false)
  requireCoverLetter Boolean               @default(false)
  status             JobStatus             @default(DRAFT)
  submittedAt        DateTime?
  claimedAt          DateTime?
  publishedAt        DateTime?
  approvedAt         DateTime?
  closedAt           DateTime?
  closedById         String?
  closedReason       String?
  rejectionReason    String?
  applicationUrl     String?
  applicationEmail   String?
  version            Int                   @default(1)
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  university   University             @relation(fields: [universityId], references: [id], onDelete: Cascade)
  postedBy     User                   @relation("JobPoster", fields: [postedById], references: [id], onDelete: Restrict)
  reviewer     User?                  @relation("JobReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approvedBy   User?                  @relation("JobApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  applications JobApplication[]
  moderations  JobModerationRecord[]

  @@index([universityId, status, publishedAt(sort: Desc)])
  @@index([universityId, status, submittedAt])
  @@index([postedById, status])
  @@index([reviewerId, status])
  @@index([category])
  @@index([deadline])
  @@index([universityId, company])
}

model JobApplication {
  id                  String                        @id @default(cuid())
  jobId               String
  applicantId         String
  coverLetter         String?                       @db.Text
  message             String?
  resumeKey           String?
  shareProfileConsent Boolean                       @default(true)
  profileSnapshot     Json?
  status              ApplicationStatus             @default(APPLIED)
  ownerNote           String?                       @db.Text
  withdrawnAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @default(now()) @updatedAt

  job       Job                           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User                          @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  history   JobApplicationStatusHistory[]

  @@unique([jobId, applicantId])
  @@index([applicantId, status])
  @@index([jobId, status])
  @@index([createdAt])
}

model JobModerationRecord {
  id                   String              @id @default(cuid())
  jobId                String
  actorId              String
  actorRole            String
  action               JobModerationAction
  reasonCode           String?
  ownerVisibleNote     String?             @db.Text
  internalNote         String?             @db.Text
  overrideOfReviewerId String?
  createdAt            DateTime            @default(now())

  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User @relation("JobModActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@index([actorId, createdAt(sort: Desc)])
}

model JobApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  note          String?            @db.Text
  createdAt     DateTime           @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("JobAppHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

model Event {
  id              String       @id @default(cuid())
  universityId    String
  createdById     String
  title           String
  slug            String
  description     String       @db.Text
  category        String       @default("GENERAL")
  organizer       String?
  startsAt        DateTime
  endsAt          DateTime
  mode            EventMode    @default(IN_PERSON)
  venue           String?
  onlineUrl       String?
  capacity        Int?
  rsvpDeadline    DateTime?
  waitlistEnabled Boolean      @default(true)
  bannerUrl       String?
  bannerPublicId  String?
  reminderEnabled Boolean      @default(true)
  reminderSentAt  DateTime?
  status          EventStatus  @default(DRAFT)
  cancelledAt     DateTime?
  cancelReason    String?
  completedAt     DateTime?
  version         Int          @default(1)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  university      University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rsvps           EventRsvp[]
  media           MediaAsset[]

  @@unique([universityId, slug])
  @@index([universityId, status, startsAt])
  @@index([category])
}

model EventRsvp {
  id           String     @id @default(cuid())
  eventId      String
  userId       String
  status       RsvpStatus @default(GOING)
  waitlistedAt DateTime?
  attendedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User       @relation("RsvpUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([eventId, status, waitlistedAt])
  @@index([userId, status])
}

model Announcement {
  id           String               @id @default(cuid())
  universityId String
  authorId     String
  title        String
  body         String               @db.Text
  category     AnnouncementCategory @default(GENERAL)
  audience     AnnouncementAudience @default(ALL)
  pinned       Boolean              @default(false)
  status       AnnouncementStatus   @default(DRAFT)
  publishAt    DateTime?
  archiveAt    DateTime?
  publishedAt  DateTime?
  archivedAt   DateTime?
  editedAt     DateTime?
  version      Int                  @default(1)
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  university   University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  author       User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([universityId, status, pinned, publishedAt(sort: Desc)])
  @@index([universityId, status, publishAt])
  @@index([universityId, category])
}

model Content {
  id           String        @id @default(cuid())
  universityId String
  createdById  String
  type         String
  title        String
  body         String
  slug         String
  mediaPublicId String?
  mediaType    MediaType?
  status       ContentStatus @default(DRAFT)
  metaTitle    String?
  metaDescription String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("ContentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([universityId, slug])
  @@index([universityId, status, publishedAt])
}

model Report {
  id             String       @id @default(cuid())
  universityId   String
  reportedById   String
  reportedUserId String?
  reviewerId     String?
  resolverId     String?
  targetType     String
  targetId       String
  type           ReportType   @default(OTHER)
  reason         String
  status         ReportStatus @default(OPEN)
  resolution     String?
  resolutionNote String?
  snapshot       Json?
  claimedAt      DateTime?
  escalatedAt    DateTime?
  overturnedAt   DateTime?
  overturnedById String?
  overturnReason String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  university     University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  reportedBy     User         @relation("ReportReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewer       User?        @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  resolver       User?        @relation("ReportResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  actions        ReportAction[]

  @@index([universityId, status, createdAt(sort: Desc)])
  @@index([reportedUserId])
  @@index([targetType, targetId])
}

model ReportAction {
  id         String   @id @default(cuid())
  reportId   String
  actorId    String
  actorRole  RoleName
  actionType String
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor      User     @relation("ReportActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([actorId, createdAt(sort: Desc)])
}

model UserRestriction {
  id             String          @id @default(cuid())
  universityId   String
  userId         String
  type           RestrictionType
  reason         String
  startsAt       DateTime        @default(now())
  endsAt         DateTime
  createdById    String
  sourceReportId String?
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?
  createdAt      DateTime        @default(now())

  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user           User            @relation("RestrictionSubject", fields: [userId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("RestrictionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, type, endsAt])
  @@index([universityId, endsAt])
}

model MediaAsset {
  id           String     @id @default(cuid())
  universityId String
  uploadedById String
  eventId      String?
  url          String
  providerKey  String?
  type         MediaType
  bytes        Int?
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  event        Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([universityId, createdAt])
  @@index([eventId])
}

model AdSlot {
  id           String     @id @default(cuid())
  universityId String
  position     String
  sponsor      String
  content      Json
  isActive     Boolean    @default(true)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId, position, isActive])
}

model AnalyticsEvent {
  id           String     @id @default(cuid())
  universityId String
  userId       String?
  eventType    String
  metadata     Json?
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([universityId, eventType, createdAt])
}

model AuditLog {
  id           String       @id @default(cuid())
  universityId String
  actorId      String?
  actorRole    String?
  action       String
  targetType   String?
  targetId     String?
  result       AuditResult  @default(SUCCESS)
  ip           String?
  userAgent    String?
  requestId    String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([universityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([result, createdAt(sort: Desc)])
  @@index([requestId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  type       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
}

model ModeratorInvitation {
  id          String    @id @default(cuid())
  email       String    @unique
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("ModeratorInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([tokenHash])
}

model UploadedFile {
  id          String        @id @default(cuid())
  userId      String
  purpose     UploadPurpose
  mediaType   MediaType     @default(IMAGE)
  publicId    String        @unique
  url         String
  secureUrl   String
  format      String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Float?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("uploaded_files")
}

enum StoryStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED
}

enum StoryCategory {
  CAREER_MILESTONE
  ENTREPRENEURSHIP
  TECH_INNOVATION
  RESEARCH_ACADEMIA
  DESIGN_PRODUCT
  CAMPUS_NOSTALGIA
  GENERAL_INSIGHT
}

enum StoryModerationAction {
  SUBMIT
  WITHDRAW
  CLAIM
  UNCLAIM
  APPROVE
  REJECT
  REQUEST_CHANGES
  UNPUBLISH
  RESTORE
  ADMIN_OVERRIDE
}

model SuccessStory {
  id                     String                  @id @default(cuid())
  universityId           String
  authorId               String
  title                  String                  @db.VarChar(120)
  slug                   String
  summary                String                  @db.VarChar(300)
  body                   String                  @db.Text
  category               StoryCategory           @default(CAREER_MILESTONE)
  tags                   String[]                @default([])
  coverImageUrl          String?
  coverImagePublicId     String?
  embeddedMediaPublicIds String[]                @default([])
  readingTimeMinutes     Int                     @default(3)
  status                 StoryStatus             @default(DRAFT)
  reviewerId             String?
  claimedAt              DateTime?
  ownerVisibleNote       String?
  internalNote           String?
  publishedAt            DateTime?
  version                Int                     @default(1)
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  university             University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  author                 User                    @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer               User?                   @relation("StoryReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  moderationHistory      StoryModerationRecord[]

  @@unique([universityId, slug])
  @@index([universityId, status, publishedAt(sort: Desc)])
  @@index([authorId, status])
  @@index([category])
}

model StoryModerationRecord {
  id          String                @id @default(cuid())
  storyId     String
  moderatorId String
  action      StoryModerationAction
  reasonCode  String?
  note        String?
  createdAt   DateTime              @default(now())

  story       SuccessStory          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  moderator   User                  @relation("StoryModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([storyId, createdAt])
  @@index([moderatorId])
}

enum ConversationContext {
  DIRECT
  MENTORSHIP
  JOB_APPLICATION
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  SYSTEM
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id                 String                   @id @default(cuid())
  universityId       String
  userLowId          String                   @db.VarChar(64)
  userHighId         String                   @db.VarChar(64)
  contextType        ConversationContext      @default(DIRECT)
  contextId          String?                  @db.VarChar(64)
  createdById        String
  lastMessageId      String?                  @unique
  lastMessageAt      DateTime?
  lastMessageSnippet String?                  @db.VarChar(255)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  university         University               @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy          User                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastMessage        Message?                 @relation("LastMessageRelation", fields: [lastMessageId], references: [id], onDelete: SetNull)
  participants       ConversationParticipant[]
  messages           Message[]                @relation("ConversationMessages")

  @@unique([universityId, userLowId, userHighId])
  @@index([universityId, lastMessageAt(sort: Desc)])
  @@index([userLowId])
  @@index([userHighId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  isPinned       Boolean      @default(false)
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived, isPinned])
  @@index([userId, unreadCount])
}

model Message {
  id                String                @id @default(cuid())
  conversationId    String
  senderId          String
  type              MessageType           @default(TEXT)
  content           String                @db.Text
  attachments       Json?
  deliveryStatus    MessageDeliveryStatus @default(SENT)
  replyToId         String?
  reactions         Json?
  isEdited          Boolean               @default(false)
  editedAt          DateTime?
  deletedForUserIds String[]              @default([])
  isDeletedForAll   Boolean               @default(false)
  deletedForAllAt   DateTime?
  readAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  conversation      Conversation          @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User                  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo           Message?              @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]             @relation("MessageReplies")
  lastInConversation Conversation?        @relation("LastMessageRelation")

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([senderId, createdAt])
  @@index([conversationId, deliveryStatus])
}




